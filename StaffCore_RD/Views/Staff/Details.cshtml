@model StaffCoreRD.Models.Staff
@{
    ViewData["Title"] = "Detalle del Empleado";
}

<h2>Perfil del Empleado</h2>

<div class="card" style="max-width: 500px;">
    <div class="card-body">
        <h4 class="card-title">@Model.Nombre</h4>
        <hr />
        <p><strong>Cédula:</strong> @Model.Cedula</p>
        <p><strong>Cargo:</strong> @Model.Cargo</p>
        <p><strong>Departamento:</strong> @Model.Departamento</p>
        <p><strong>Salario:</strong> @Model.Salario.ToString("C")</p>
        <p><strong>Fecha de ingreso:</strong> @Model.FechaIngreso.ToString("dd/MM/yyyy")</p>
        <p><strong>Estado:</strong> @(Model.Activo ? "Activo" : "Inactivo")</p>

        <a asp-action="Index" class="btn btn-secondary mt-2">Volver</a>
    </div>
</div>